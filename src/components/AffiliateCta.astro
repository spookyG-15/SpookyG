---
import Disclosure from './Disclosure.astro';
import { formatDate } from '../lib/format';
import { getSite } from '../lib/site';
import type { AffiliateState } from '../lib/affiliate';

interface Props {
  state: AffiliateState;
  url?: string;
  addedAt?: string;
}

const { state, url, addedAt } = Astro.props;

const { defaultDisclosure } = await getSite();

const messages: Record<AffiliateState, string> = {
  active: '',
  old: 'This link is old. Availability may have changed.',
  expired: 'This link expired — look for the product in TikTok Shop.',
  none: 'No affiliate link for this one right now.',
  hidden: "We haven't checked this store yet, so we're not sending you to it.",
};

const showButton = state === 'active' || state === 'old';
---

<div class="mt-6">
  {
    showButton && url ? (
      <>
        <a
          class="btn btn-primary w-full sm:w-auto"
          href={url}
          rel="sponsored nofollow noopener"
          target="_blank"
        >
          Check this listing on TikTok Shop
          <svg
            width="18"
            height="18"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M7 4h9v9M16 4 5 15" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="sr-only">(opens in a new tab)</span>
        </a>
        <Disclosure text={defaultDisclosure} />
        {addedAt && <p class="m-0 mt-2 text-[13px] text-ink-soft">Link added {formatDate(addedAt)}.</p>}
      </>
    ) : (
      <p class="m-0 rounded-md bg-bg-soft p-4 text-[15px] leading-snug text-ink">{messages[state]}</p>
    )
  }

  {
    state === 'old' && (
      <p class="m-0 mt-3 flex gap-2 rounded-md bg-warn-soft p-3 text-[14px] leading-snug text-warn">
        <svg
          width="18"
          height="18"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          focusable="false"
          class="mt-0.5 shrink-0"
        >
          <path d="M10 3.2 18 17H2L10 3.2Z" stroke-linejoin="round" />
          <path d="M10 8v4M10 14.4v.1" stroke-linecap="round" />
        </svg>
        <span>{messages.old}</span>
      </p>
    )
  }
</div>
