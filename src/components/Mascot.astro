---
import { closeSync, existsSync, openSync, readSync } from 'node:fs';
import { resolve } from 'node:path';

interface Props {
  variant?: 'full' | 'head';
  size?: number;
  alt?: string;
  class?: string;
}

const {
  variant = 'full',
  size = 200,
  alt,
  class: className = '',
} = Astro.props;

const SOURCES = {
  full: '/images/site/mascot.png',
  head: '/images/site/mascot-head.png',
} as const;

const MASCOT_ALT =
  'Spooky-G mascot: a smiling white ghost wearing black sunglasses and a backwards dark cap, making a peace sign.';

const source = SOURCES[variant];
const filePath = resolve(process.cwd(), 'public', source.slice(1));

function hasAlphaChannel(path: string): boolean {
  try {
    const handle = openSync(path, 'r');
    try {
      const header = Buffer.alloc(26);
      const bytesRead = readSync(handle, header, 0, header.length, 0);
      const isPng = header.subarray(1, 4).toString('ascii') === 'PNG';
      return isPng && bytesRead === header.length && (header[25] === 4 || header[25] === 6);
    } finally {
      closeSync(handle);
    }
  } catch {
    return true;
  }
}

const isAvailable = existsSync(filePath);
const isOpaque = !hasAlphaChannel(filePath);
const resolvedAlt = alt ?? (variant === 'full' ? MASCOT_ALT : '');
const width = size;
const height = variant === 'head' ? size : Math.round(size * 1.15);
const needsSoftPanel = isOpaque && variant === 'head';
---

{
  isAvailable ? (
    <img
      src={source}
      alt={resolvedAlt}
      width={width}
      height={height}
      loading={variant === 'full' ? 'eager' : 'lazy'}
      decoding="async"
      class:list={[needsSoftPanel && 'ghost-panel', className]}
      style={`width:${width}px;height:${height}px;`}
    />
  ) : (
    <span class:list={['ghost-mark', className]} style={`width:${width}px;height:${height}px;`}>
      <svg viewBox="0 0 64 64" role="presentation" aria-hidden="true" focusable="false">
        <path
          d="M32 6c-11.05 0-20 8.51-20 19v29c0 1.9 2.1 3 3.6 1.9l4.9-3.6 4.9 3.6a2.6 2.6 0 0 0 3.2 0l3.4-2.5 3.4 2.5a2.6 2.6 0 0 0 3.2 0l4.9-3.6 4.9 3.6c1.5 1.1 3.6 0 3.6-1.9V25c0-10.49-8.95-19-20-19Z"
          fill="#ffffff"
          stroke="#1b1e27"
          stroke-width="2.5"
          stroke-linejoin="round"></path>
        <rect x="15" y="24" width="15" height="11" rx="5" fill="#1b1e27"></rect>
        <rect x="34" y="24" width="15" height="11" rx="5" fill="#1b1e27"></rect>
        <path d="M30 27.5h4" stroke="#1b1e27" stroke-width="2.5" stroke-linecap="round"></path>
      </svg>
      <span class="sr-only">{resolvedAlt}</span>
    </span>
  )
}
