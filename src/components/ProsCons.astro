---
interface Props {
  pros: string[];
  cons: string[];
}

const { pros, cons } = Astro.props;
---

<section aria-labelledby="pros-cons-heading" class="mt-10">
  <h2 id="pros-cons-heading" class="t-h3 m-0 mb-4">The honest bit</h2>
  <div class="grid gap-4 md:grid-cols-2">
    <div class="panel">
      <h3 class="t-overline m-0 mb-3">What worked</h3>
      <ul class="m-0 list-disc space-y-2 p-0 pl-5 text-[16px] text-ink">
        {pros.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div class="panel">
      <h3 class="t-overline m-0 mb-3">What didn't</h3>
      <ul class="m-0 list-disc space-y-2 p-0 pl-5 text-[16px] text-ink">
        {cons.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>
