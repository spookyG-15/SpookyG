---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { getSite } from '../lib/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex = false } = Astro.props;

const assetExists = (path: string | undefined): path is string =>
  path !== undefined && existsSync(resolve(process.cwd(), 'public', path.replace(/^\//, '')));

const canonical = Astro.site === undefined ? undefined : new URL(Astro.url.pathname, Astro.site);
const socialImage = assetExists(image) ? image : undefined;
const { siteName } = await getSite();
---

<title>{title}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical.href} />}
{noindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical.href} />}
{socialImage && <meta property="og:image" content={new URL(socialImage, Astro.site ?? Astro.url).href} />}
<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{socialImage && <meta name="twitter:image" content={new URL(socialImage, Astro.site ?? Astro.url).href} />}
