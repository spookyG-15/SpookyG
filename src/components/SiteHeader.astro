---
import Mascot from './Mascot.astro';

interface Props {
  siteName: string;
}

const { siteName } = Astro.props;

const links = [
  { href: '/reviews/', label: 'Reviews' },
  { href: '/about/', label: 'About' },
  { href: '/affiliate-disclosure/', label: 'Disclosure' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string): boolean => path === href;
const itemClass =
  'inline-flex min-h-11 items-center rounded-md px-1 text-[15px] font-semibold text-ink transition-colors duration-150 hover:text-accent';
---

<header class="border-b border-line bg-bg">
  <div class="page flex min-h-16 items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center gap-2 rounded-md no-underline">
      <Mascot variant="head" size={30} alt="" />
      <span class="text-lg font-bold tracking-tight text-ink">{siteName}</span>
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-5">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[itemClass, isCurrent(link.href) && 'text-accent']}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="relative md:hidden">
      <summary
        class="flex min-h-11 cursor-pointer list-none items-center rounded-md border border-line px-4 text-[15px] font-semibold text-ink [&::-webkit-details-marker]:hidden"
      >
        Menu
      </summary>
      <nav
        aria-label="Mobile"
        class="absolute right-0 z-40 mt-2 w-56 rounded-lg border border-line bg-bg p-2"
      >
        <ul>
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    'flex min-h-11 items-center rounded-md px-3 font-semibold no-underline',
                    isCurrent(link.href) ? 'text-accent' : 'text-ink',
                  ]}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
