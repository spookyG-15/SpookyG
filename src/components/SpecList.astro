---
interface Props {
  specs: { label: string; value: string }[];
}

const { specs } = Astro.props;
---

{
  specs.length > 0 && (
    <dl class="m-0 grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-[minmax(9rem,auto)_1fr]">
      {specs.map((spec) => (
        <>
          <dt class="text-[15px] font-semibold text-ink">{spec.label}</dt>
          <dd class="m-0 text-[15px] text-ink-soft">{spec.value}</dd>
        </>
      ))}
    </dl>
  )
}
