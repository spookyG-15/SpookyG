---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { CATEGORIES } from '../../content.config';
import { getSite } from '../../lib/site';
import { getPublishedReviews } from '../../lib/reviews';

const site = await getSite();
const reviews = await getPublishedReviews();
const categories = CATEGORIES.filter((category) =>
  reviews.some((review) => review.data.category === category)
);

const plural = (count: number): string => (count === 1 ? 'review' : 'reviews');
---

<BaseLayout
  title={`All reviews — ${site.siteName}`}
  description="Every published Spooky-G review, newest first. Filter by category: home and kitchen, beauty, phone and gadgets, fashion, health and wellness."
  image={site.ogImage}
>
  <div class="page pt-8 md:pt-12">
    <header class="max-w-[60ch]">
      <h1 class="t-h1 m-0">All reviews</h1>
      <p class="mt-3 mb-0 text-[17px] text-ink-soft">
        {reviews.length} honest {plural(reviews.length)} on TikTok finds. Newest first.
      </p>
    </header>

    {categories.length > 1 && <CategoryFilter categories={categories} active={null} />}

    <p id="review-count" class="t-meta mt-6 mb-0" role="status" aria-live="polite">
      Showing all {reviews.length} {plural(reviews.length)}
    </p>

    {
      reviews.length > 0 ? (
        <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {reviews.map((review) => (
            <ReviewCard review={review} />
          ))}
        </div>
      ) : (
        <div class="panel mt-6">
          <p class="m-0">No reviews here yet. Check back soon, boo.</p>
        </div>
      )
    }

    <div id="review-empty" class="panel mt-6" hidden>
      <p class="m-0">Nothing in this category yet, boo.</p>
      <button type="button" class="btn btn-secondary mt-4" data-category-filter="all">
        Show all
      </button>
    </div>
  </div>
</BaseLayout>

<script>
  const chips = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-category-chip]')
  );
  const controls = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-category-filter]')
  );
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-review-card]'));
  const count = document.getElementById('review-count');
  const empty = document.getElementById('review-empty');

  function plural(value: number): string {
    return value === 1 ? 'review' : 'reviews';
  }

  function applyFilter(value: string): void {
    chips.forEach((chip) => {
      chip.setAttribute('aria-pressed', String(chip.dataset.categoryFilter === value));
    });

    let shown = 0;
    cards.forEach((card) => {
      const matches = value === 'all' || card.dataset.category === value;
      card.hidden = !matches;
      if (matches) shown += 1;
    });

    if (count !== null) {
      count.textContent =
        value === 'all'
          ? `Showing all ${shown} ${plural(shown)}`
          : `Showing ${shown} ${plural(shown)}`;
    }

    if (empty !== null) {
      empty.hidden = shown > 0;
    }
  }

  controls.forEach((control) => {
    control.addEventListener('click', () => {
      applyFilter(control.dataset.categoryFilter ?? 'all');
    });
  });
</script>
